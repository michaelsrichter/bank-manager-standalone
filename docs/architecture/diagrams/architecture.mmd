%%{init: {"theme": "base", "themeVariables": {"fontSize": "16px"}}}%%
flowchart TB
  user["<b>Browser</b><br/>React + TypeScript SPA<br/>alias + GUID kept in local storage"]
  subgraph azure["<b>Azure subscription · resource group rg-&lt;env&gt;</b>"]
    direction TB
    subgraph vnet["<b>Virtual network</b> (10.40.0.0/16)"]
      direction TB
      subgraph aca["<b>Azure Container Apps</b> (Consumption, scale 0–2)"]
        api["<b>FastAPI backend</b><br/>rate limits · NDJSON streaming<br/>health · safe telemetry"]
        acs["<b>ACS policy engine</b><br/>Agent Control Specification<br/>+ Open Policy Agent (Rego)"]
        tools["<b>Synthetic bank tools</b><br/>no side effects"]
      end
      pe["<b>Private endpoint</b>"]
    end
    foundry["<b>Azure AI Foundry</b> (AIServices)<br/>gpt-4.1 · gpt-4.1-mini<br/>content filters ON · keys disabled<br/>public network OFF"]
    acr["<b>Azure Container Registry</b><br/>image pulled with managed identity"]
    mi["<b>User-assigned managed identity</b>"]
    appi["<b>Application Insights</b><br/>Entra-only ingestion"]
    law["<b>Log Analytics</b> (30 days)"]
    guard["<b>Budget + 5xx alert</b>"]
  end
  user -- "HTTPS (public ingress)" --> api
  api --> acs --> tools
  api -- "Entra token" --> pe --> foundry
  mi -. "Cognitive Services OpenAI User" .-> foundry
  mi -. "AcrPull" .-> acr
  mi -. "Monitoring Metrics Publisher" .-> appi
  api -- "operational events only" --> appi --> law
  guard -. watches .-> aca

  classDef edge fill:#fde2e1,stroke:#b3261e,color:#1b1f24
  classDef app fill:#e3ecf8,stroke:#0f5ca8,color:#1b1f24
  classDef ai fill:#dff3e4,stroke:#0b7a3b,color:#1b1f24
  classDef ops fill:#fff1d6,stroke:#8a5a00,color:#1b1f24
  class user edge
  class api,acs,tools,pe app
  class foundry ai
  class acr,mi,appi,law,guard ops
