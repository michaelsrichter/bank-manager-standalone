{
  "name": "bank-manager-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/build-info.mjs && node scripts/build-docs.mjs",
    "build": "tsc -b && vite build",
    "predev": "node scripts/build-info.mjs && node scripts/build-docs.mjs",
    "dev": "vite",
    "pretest": "node scripts/build-info.mjs && node scripts/build-docs.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/build-info.mjs && node scripts/build-docs.mjs",
    "test:coverage": "vitest run --coverage",
    "prelint": "node scripts/build-info.mjs && node scripts/build-docs.mjs",
    "lint": "eslint . && prettier --check . && tsc -b --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
