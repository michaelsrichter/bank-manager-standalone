# ---------------------------------------------------------------------------
# .gitignore — stack-agnostic (Node, Python, .NET) + Azure/azd + VS Code + OS.
# This template doesn't fix a backend language, so all three ecosystems are
# covered; trim what you don't need once a demo is scaffolded.
# ---------------------------------------------------------------------------

# --- Environment & secrets (never commit real secrets — see SECURITY.md) ---
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
appsettings.*.local.json
secrets.json

# ===========================================================================
# .NET / ASP.NET Core / Azure Functions (if backend is .NET)
# ===========================================================================
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Ll]og/
[Ll]ogs/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
TestResults/
BenchmarkDotNet.Artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
.nuget/
project.lock.json
project.fragment.lock.json
msbuild.log
msbuild.err
msbuild.wrn

# ===========================================================================
# Python (if backend is Python)
# ===========================================================================
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ===========================================================================
# Node / React / Vite (frontend, or a Node backend)
# ===========================================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/
.parcel-cache/
.nyc_output/
coverage/
*.local

# ===========================================================================
# Azure / IaC / azd
# ===========================================================================
.azure/
.azd/
*.azurePubxml
*.pubxml.user
azd.env

# ===========================================================================
# VS Code — keep shared config, ignore personal settings
# ===========================================================================
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/*.code-snippets
.history/

# ===========================================================================
# OS / misc
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Generated at build time by frontend/scripts/build-docs.mjs
frontend/public/docs-assets/


# Local tool binaries (make install-opa)
.tools/
wheels/
.playwright-mcp/

