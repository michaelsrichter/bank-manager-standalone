# ---------------------------------------------------------------------------
# Non-secret local settings only. Copy to .env if your shell loads it.
# There are NO secrets in this demo: Azure access uses Microsoft Entra ID
# (`az login` locally, managed identity in Azure). See docs/security/secrets.md.
# ---------------------------------------------------------------------------

# 1 = deterministic fake model router (mandatory in CI). 0 = real Azure OpenAI.
FAKE_AI=1

# Azure OpenAI endpoint of the Foundry account (azd env get-value AZURE_AI_ENDPOINT).
AZURE_AI_ENDPOINT=

# Optional: user-assigned managed identity client ID (set automatically in Azure).
AZURE_CLIENT_ID=

# Optional: Application Insights connection string (identifier, not a secret;
# local auth is disabled, so ingestion requires an Entra token).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Path to an OPA 1.x binary used by the ACS policy engine (make install-opa).
ACS_OPA_PATH=.tools/opa

# Abuse limits (defaults shown).
RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_SESSION_PER_MINUTE=10
MAX_REQUEST_BYTES=8192
MAX_PROMPT_CHARS=500
HEALTH_CACHE_SECONDS=60
